<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
</head>
<body>
    <div>
        <h1>Add Product page</h1>
    <form action="/product/productdetail" method="post">
        <div>
            <label for="Title">Title</label>
            <input type="text" placeholder="Enter your Product name" name="title">
        </div>
        <div>
            <label for="price">Price</label>
            <input type="text" placeholder="Enter your Product price" name="price">
        </div>
        <div>
            <label for="Description">Description</label>
            <input type="text" placeholder="Enter your Product Description" name="description">
        </div>
        <div>
            <label for="Category">Category</label>
            <input type="text" placeholder="Enter your Product Category" name="category">
        </div>
        <div>
            <label for="Image">Image</label>
            <input type="text" placeholder="Enter your Product Image" name="Image">
        </div>
        <button type="submit">Submit</button>
    </form>
    </div>
</body>
</html>