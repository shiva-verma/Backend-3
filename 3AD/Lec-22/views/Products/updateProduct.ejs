
    <div>
        <h1>Update Product page</h1>
    <form action="/productdetail/<%= product._id%>?_method=PATCH" method="post">
        <div>
            <label for="Title">Title</label>
            <input type="text" placeholder="Enter your Product name" name="title" value="<%=  product.title %>">
        </div>
        <div>
            <label for="price">Price</label>
            <input type="text" placeholder="Enter your Product price" name="price" value="<%= product.price %>" >
        </div>
        <div>
            <label for="Description">Description</label>
            <input type="text" placeholder="Enter your Product Description" name="description" value="<%= product.description %>" >
        </div>
        <div>
            <label for="Category">Category</label>
            <input type="text" placeholder="Enter your Product Category" name="category" value="<%= product.category %>" >
        </div>
        <div>
            <label for="Image">Image</label>
            <input type="text" placeholder="Enter your Product Image" name="Image" value="<%= product.Image %>" >
        </div>
        <button type="submit">Submit</button>
    </form>
    </div>
