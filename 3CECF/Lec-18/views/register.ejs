<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
</head>
<body>
    <div>
        <form method="post" action="/signup">
            <div>
                <label for="username">User name</label>
                <input id="username" type="text" placeholder="Enter Your full name" name="username">
                
            </div>
            <div>
                <label for="">Email</label>
                <input type="email" placeholder="Enter Your Email" name="email">
                
            </div>
            <div>
                <label for="">Password</label>
                <input type="password" placeholder="Enter Your Password" name="password">
                
            </div>
            <div>
                <label for="">Mobile number</label>
                <input type="number" placeholder="Enter Your mobile number" name="phone">
                
            </div>
            <div>
                <h3>User role: </h3>
                <input class="form-check-input" type="radio" name="role" id="buyer" >
                <label class="form-check-label" for="buyer">Buyer</label>
                <input class="form-check-input" type="radio" name="role" id="seller">
                <label class="form-check-label" for="seller">Seller</label>
                
            </div>
            <div>
                <button type="submit">Submit</button>
            </div>
        </form>
    </div>
</body>
</html>