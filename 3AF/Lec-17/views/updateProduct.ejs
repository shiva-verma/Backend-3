<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
</head>
<body>
    <div>
        <h1>UPDATE PRODUCT</h1>
        <form action="/product/update/<%= product._id %>?_method=PATCH" method="post">
            <div>
                <label for="">Title</label>
                <input type="text" placeholder="Enter your Title" name="title" value="<%= product.title  %>">
            </div>
            <div>
                <label for="">Description</label>
                <input type="text" placeholder="Enter your Description" name="description" value="<%= product.description  %>">
            </div>
            <div>
                <label for="">Price</label>
                <input type="number" placeholder="Enter your Price" name="Price" value="<%= product.Price  %>">
            </div>
            <div>
                <label for="">Category</label>
                <input type="text" placeholder="Enter your Category" name="category" value="<%= product.category  %>">
            </div>
            <div>
                <label for="">Image</label>
                <input type="text" placeholder="Enter your image" name="Image" value="<%= product.Image  %>">
            </div>
            <button type="submit">EDIT</button>
        </form>
    </div>
</body>
</html>